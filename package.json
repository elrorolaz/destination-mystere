{
  "name": "destination-mystere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jeu quotidien : deviner une destination européenne à partir d'un itinéraire en transports en commun.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:cities": "tsx scripts/prepare-cities.ts",
    "prepare:airports": "tsx scripts/prepare-airports.ts",
    "prepare:data": "tsx scripts/prepare-cities.ts && tsx scripts/prepare-airports.ts",
    "data:import": "tsx scripts/import-db.ts",
    "challenge:generate": "tsx scripts/generate-daily.ts",
    "check:itinerary": "tsx scripts/check-itinerary.ts",
    "check:leg-geometry": "tsx scripts/check-leg-geometry.ts",
    "diagnose:zone": "tsx scripts/diagnose-zone.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "maplibre-gl": "^5.0.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@6.12.0": true
  }
}
