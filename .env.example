# Base de données PostgreSQL (locale ou managée)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/destination_mystere

# API SNCF (Navitia) — token gratuit : https://digital.sncf.com/startup/api/token
# Utilisée seulement si ROUTER=navitia (sinon routeur Transitous sans clé, par défaut).
SNCF_API_TOKEN=

# Routeur d'itinéraires réels pour la génération quotidienne (M2) :
#   transitous (défaut, GTFS Europe, aucune clé) | navitia (nécessite SNCF_API_TOKEN)
ROUTER=transitous

# Secret protégeant la route cron de génération quotidienne (M2) :
# POST /api/cron/generate-daily avec « Authorization: Bearer $CRON_SECRET »
CRON_SECRET=

# Secret NextAuth (authentification)
AUTH_SECRET=

# Fond de carte OpenFreeMap (gratuit, sans clé)
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/styles/liberty

# Itinéraire de test quand aucun défi n'existe pour la date du jour (jalons M2/M3) :
#   true   → fixture figé data/fixtures/demo-journey.json (déterministe) ;
#   random → itinéraire aléatoire, renouvelable via le bouton 🎲 (/api/dev/reroll).
DEV_FIXTURE=false

# Endpoint Overpass pour le tracé de fin de partie sur les voies ferrées
# (optionnel — par défaut : overpass-api.de puis overpass.kumi.systems)
# OVERPASS_URL=
