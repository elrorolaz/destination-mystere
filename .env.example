# Base de données PostgreSQL (locale ou managée)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/destination_mystere

# API SNCF (Navitia) — token gratuit : https://digital.sncf.com/startup/api/token
SNCF_API_TOKEN=

# Secret protégeant la route cron de génération quotidienne
CRON_SECRET=

# Secret NextAuth (authentification)
AUTH_SECRET=

# Fond de carte OpenFreeMap (gratuit, sans clé)
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/styles/liberty

# Charge l'itinéraire figé data/fixtures/demo-journey.json au lieu du cron/APIs
# quand aucun défi n'existe pour la date du jour (tests déterministes, jalons M2/M3).
DEV_FIXTURE=false

# Endpoint Overpass pour le tracé de fin de partie sur les voies ferrées
# (optionnel — par défaut : overpass-api.de puis overpass.kumi.systems)
# OVERPASS_URL=
