// Destination Mystère — modèle de données (spécification §4).
// Le champ pivot « journey » (JSON) contient l'itinéraire complet : tous les
// indices sont des projections de cette structure (§4, « Contenu de journey »).
//
// M3 : GameSession accepte les parties « invité » (guestKey de cookie) tant
// que les comptes n'existent pas (jalon M4). L'unicité d'une partie par
// joueur et par jour (§7) est garantie par (userId, date) pour les comptes
// et (guestKey, date) pour les invités.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id              String  @id // identifiant GeoNames — jamais le nom (homonymes)
  name            String
  country         String
  lat             Float
  lng             Float
  population      Int
  hasTrainStation Boolean @default(false)
  geohash         String // précision 6, pour l'index spatial du snap

  routeOrigins      DailyRoute[] @relation("DailyRouteOrigin")
  routeDestinations DailyRoute[] @relation("DailyRouteDestination")

  @@index([country])
  @@index([geohash])
}

// Une ligne par jour (fuseau Europe/Paris) : le « match » du jour est composé
// de ROUTE_COUNT itinéraires (DailyRoute), joués l'un après l'autre.
// Les colonnes originCityId/destCityId/journey/totalDurationMin sont
// DÉPRÉCIÉES (avant le match en 3 itinéraires) : conservées nullable pour
// préserver l'historique, plus utilisées par le code.
model DailyChallenge {
  challengeDate    DateTime @id
  generatedAt      DateTime  @default(now())
  originCityId     String?
  destCityId       String?
  journey          Json?
  totalDurationMin Int?

  routes       DailyRoute[]
  gameSessions GameSession[]
}

// Un itinéraire du jour (3 par jour, routeIndex 1..3). Le journey complet est
// stocké ici — JAMAIS envoyé au client avant la fin de la manche concernée.
model DailyRoute {
  challengeDate    DateTime
  routeIndex       Int // 1..ROUTE_COUNT
  originCityId     String
  destCityId       String
  journey          Json // segments complets de CET itinéraire
  totalDurationMin Int
  generatedAt      DateTime @default(now())

  challenge       DailyChallenge @relation(fields: [challengeDate], references: [challengeDate])
  originCity      City           @relation("DailyRouteOrigin", fields: [originCityId], references: [id])
  destinationCity City           @relation("DailyRouteDestination", fields: [destCityId], references: [id])

  @@id([challengeDate, routeIndex])
  @@index([originCityId])
  @@index([destCityId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  pseudo       String
  passwordHash String
  createdAt    DateTime @default(now())

  gameSessions GameSession[]
  stats        UserStats?
}

// GameSession = le MATCH du jour pour un joueur (les 3 itinéraires).
// Une manche (un itinéraire) = une RouteSession.
model GameSession {
  id            String    @id @default(cuid())
  userId        String? // M4 : compte authentifié
  guestKey      String? // M3 : invité (cookie httpOnly)
  challengeDate DateTime
  status        String // ACTIVE tant qu'une manche est en cours, DONE à la fin du match
  currentRouteIndex Int   @default(1) // manche en cours (1..3)
  totalScore    Int       @default(0) // somme des scores des manches terminées
  // DÉPRÉCIÉS (miroir de la manche courante avant le match en 3 itinéraires).
  attemptCount  Int?
  score         Int?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  user           User?          @relation(fields: [userId], references: [id])
  dailyChallenge DailyChallenge @relation(fields: [challengeDate], references: [challengeDate])
  routeSessions  RouteSession[]

  // Anti-triche : une seule partie (match) par joueur et par jour (§7).
  @@unique([userId, challengeDate])
  @@unique([guestKey, challengeDate])
  @@index([challengeDate, status])
}

// Une manche = un itinéraire du jour joué par le match (GameSession).
model RouteSession {
  id           String    @id @default(cuid())
  sessionId    String
  routeIndex   Int // 1..3 : quel itinéraire du jour
  status       String // ACTIVE | WON | LOST
  attemptCount Int       @default(0)
  score        Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  session GameSession @relation(fields: [sessionId], references: [id])
  guesses Guess[]

  @@unique([sessionId, routeIndex])
  @@index([sessionId])
}

model Guess {
  id             String  @id @default(cuid())
  routeSessionId String
  sessionId      String? // DÉPRÉCIÉ (avant RouteSession) — conservé pour l'historique
  attemptNumber  Int
  clickLat       Float // le client n'envoie QUE lat/lng (§7)
  clickLng       Float
  snappedCityId  String // ville rattachée par le serveur
  correct        Boolean

  routeSession RouteSession @relation(fields: [routeSessionId], references: [id])

  @@index([routeSessionId])
}

model UserStats {
  userId       String @id
  currentStreak Int    @default(0)
  bestStreak   Int    @default(0)
  totalScore   Int    @default(0)
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)

  user User @relation(fields: [userId], references: [id])
}
